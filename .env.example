# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=3000

# Local dev: docker-compose (see docker-compose.yml)
#   postgresql://admin:password@localhost:5432/urlshortener
# Production: Supabase pooler connection string, set in Render's env vars
DATABASE_URL=

# Local dev: redis://localhost:6379
# Production: Upstash rediss:// URL, set in Render's env vars
REDIS_URL=

# Origin this service hands out in short links.
# Local: http://localhost:3000   Production: https://<your-app>.onrender.com
BASE_URL=
